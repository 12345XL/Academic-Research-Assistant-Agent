# scripts/local_services.py up generates random local values in .env.
# For independently managed services, replace these placeholders.
DATABASE_URL=postgresql://research:REPLACE_ME@127.0.0.1:54329/research_agent
S3_ENDPOINT_URL=http://127.0.0.1:8333
S3_ACCESS_KEY_ID=REPLACE_ME
S3_SECRET_ACCESS_KEY=REPLACE_ME
S3_BUCKET=research-papers
S3_REGION=us-east-1

# Optional generation: credentials remain server-side. False means no paid calls.
RESEARCH_GENERATION_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# P3 Harness. Default requests cap model calls at 2; explicitly enabling repair
# allows at most 4 calls and one correction. Input characters are NOT tokens.
RESEARCH_RUN_DEADLINE_SECONDS=100
RESEARCH_MAX_MODEL_CALLS=4
RESEARCH_MAX_PROMPT_CHARS=48000
RESEARCH_MAX_COMPLETION_TOKENS=2048
RESEARCH_MAX_REPAIRS=1

# Omit to retain local_public mode. Do not configure an empty value: fail closed.
# The policy file stores SHA-256 token hashes, not plaintext. Keep it in ignored .local/.
# RESEARCH_ACCESS_POLICY_FILE=.local/access-policy.json
